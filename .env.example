# Application
APP_NAME=OM Recycling Asset Manager
APP_ENV=development

# PostgreSQL
POSTGRES_DB=om_asset_manager
POSTGRES_USER=om_asset
POSTGRES_PASSWORD=change_this_password

# Database connection
DATABASE_URL=postgresql+psycopg://om_asset:change_this_password@postgres:5432/om_asset_manager

# Redis
REDIS_URL=redis://redis:6379/0